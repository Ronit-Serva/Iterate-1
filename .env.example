# Copy to .env; keep credentials out of source control and browser data.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=mistralai/mistral-large-4-1t-a52b
NVIDIA_API_KEY=
# Optional per-agent model overrides (must support function tools):
# AGENT1_MODEL=mistralai/mistral-large-4-1t-a52b
# AGENT2_MODEL=mistralai/mistral-large-4-1t-a52b
# Generic alternative credential name: LLM_API_KEY
RPC_URL=http://127.0.0.1:8545

LLM_REASONING_EFFORT=low

LLM_MAX_TOKENS=4096
