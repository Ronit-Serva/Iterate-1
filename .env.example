# Copy to .env; keep credentials out of source control and browser data.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_API_KEY=
# Optional per-agent model overrides (must support function tools):
# AGENT1_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# AGENT2_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Generic alternative credential name: LLM_API_KEY
RPC_URL=http://127.0.0.1:8545

LLM_REASONING_EFFORT=

LLM_MAX_TOKENS=4096

# Nemotron-only cap on internal reasoning; reserves output tokens for the answer.
LLM_REASONING_BUDGET=128
