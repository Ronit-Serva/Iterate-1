{
  "name": "iterate-1",
  "version": "1.0.0",
  "description": "Two LLM agents using A2A task polling and execute-before-settle x402",
  "main": "index.js",
  "scripts": {
    "ui": "tsx apps/dashboard/src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "node": "hardhat node --hostname 127.0.0.1",
    "compile": "node scripts/compile.mjs",
    "typecheck": "tsc --noEmit",
    "compile:hardhat": "hardhat compile",
    "check:loopback": "node scripts/check-loopback.mjs",
    "facilitator": "tsx scripts/facilitator.mjs",
    "server": "tsx apps/server/src/index.ts",
    "client": "tsx apps/client/src/index.ts",
    "demo": "tsx apps/client/src/index.ts",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "fixture": "node --import tsx scripts/fixture.mjs",
    "experiment": "tsx apps/client/src/index.ts",
    "start": "tsx scripts/start.ts",
    "verify": "tsx scripts/iteration1-check.ts",
    "check": "npm run compile && npm run typecheck && npm test",
    "ui:check": "tsx scripts/dashboard-check.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@openzeppelin/contracts": "5.6.1",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "express": "5.3.0",
    "viem": "2.57.11"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "hardhat": "3.21.0",
    "solc": "0.8.38",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "private": true
}
